{
  "manifest_version": 3,
  "name": "Atlas — AI Web Accessibility Agent",
  "version": "0.1.0",
  "description": "Atlas simplifies any website for elderly and disabled users via an AI-powered sidebar and voice commands.",
  "permissions": ["activeTab", "storage", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Activate Atlas",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
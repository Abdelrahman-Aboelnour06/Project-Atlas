{
  "manifest_version": 3,
  "name": "Atlas — AI Web Accessibility Agent",
  "version": "0.2.0",
  "description": "Atlas simplifies any website for elderly and disabled users via an AI-powered sidebar and voice commands.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "webNavigation",
    "downloads",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Activate Atlas",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Command+Shift+A"
      },
      "description": "Toggle Atlas Sidebar"
    },
    "voice-input": {
      "suggested_key": {
        "default": "Alt+V",
        "mac": "Command+Shift+V"
      },
      "description": "Start Voice Recognition"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidebar.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
      "maxlength": 14,
      "required": true,
      "fake_value": "00000000000000"
    },
    {
      "field_id": "plate-digits",
      "name": "plate_digits",
      "type": "text",
      "pattern": "[0-9]{1,4}",
      "maxlength": 4,
      "required": true,
      "fake_value": "1234"
    },
    {
      "field_id": "plate-letters",
      "name": "plate_letters",
      "type": "text",
      "pattern": "[\\u0600-\\u06FF\\s]{1,4}",
      "maxlength": 7,
      "required": true,
      "fake_value": "أ ب ج"
    }
  ],
  "expected_end_state": {
    "status": "goal_complete",
    "results_container_id": "violations-results",
    "violations_table_id": "violations-table",
    "total_amount_id": "total-amount",

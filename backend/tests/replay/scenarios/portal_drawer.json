  "start_page": "portal-drawer.html",
  "goal_text": {
    "ar": "البحث عن مخالفات المرور في القائمة الجانبية",
    "en": "Find traffic violations in the sidebar drawer menu"
  },
  "expected_target_page": "portal-inquiry.html",
